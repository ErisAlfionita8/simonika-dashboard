# Lokal : salin menjadi .streamlit/secrets.toml (file itu JANGAN di-commit ke Git).
# Deploy: tempel isi ini di Streamlit Community Cloud > App settings > Secrets.
[connections.simonika]
dialect  = "postgresql"
host     = "GANTI_DENGAN_HOST_DATABASE"      # saat deploy bukan "localhost": pakai host database yang bisa diakses dari internet
port     = 5432
database = "simonika_dw"
username = "postgres"
password = "GANTI_DENGAN_PASSWORD_DATABASE"
query    = { sslmode = "require" }           # banyak layanan PostgreSQL (Supabase, Neon, Railway, dll.) mewajibkan SSL

# Sandi untuk halaman Manajemen Data (admin)
[admin]
password = "GANTI_DENGAN_SANDI_ADMIN"
